# =============================================================================
# VoiceBridge AI - Root environment template
# Copy this file to .env and fill in your secrets.
# These values are consumed by docker-compose.yml.
# =============================================================================

# ---------- Core ----------
NODE_ENV=development
TZ=UTC

# ---------- PostgreSQL ----------
POSTGRES_USER=voicebridge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=voicebridge
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Backend ----------
BACKEND_PORT=4000
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
AES_ENCRYPTION_KEY=32-byte-base64-encoded-key

# ---------- Admin ----------
ADMIN_PORT=3000
ADMIN_API_URL=http://localhost:4000

# ---------- AI Providers (configure the ones you use) ----------
# Speech-to-text
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
GOOGLE_SPEECH_KEY=

# Translation
GOOGLE_TRANSLATE_KEY=
DEEPL_API_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Text-to-speech
ELEVENLABS_API_KEY=
AZURE_TTS_KEY=
AZURE_TTS_REGION=
GOOGLE_TTS_KEY=

# Default provider selection (openai|deepgram|google for STT, etc.)
STT_PROVIDER=openai
TRANSLATE_PROVIDER=openai
TTS_PROVIDER=elevenlabs

# ---------- OAuth ----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# ---------- OTP / SMS ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---------- Payments ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=

# ---------- Object Storage (S3-compatible) ----------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=voicebridge-recordings
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- WebRTC ----------
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
