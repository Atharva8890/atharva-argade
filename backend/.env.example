# VoiceBridge AI - Backend-specific environment overrides.
# Values shared with other services live in the root .env.

PORT=4000
LOG_LEVEL=info

# When running outside docker-compose, point these at your local services.
DATABASE_URL=postgres://voicebridge:changeme@localhost:5432/voicebridge
REDIS_URL=redis://localhost:6379

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,capacitor://localhost,http://localhost

# Rate limiting (requests per minute)
RATE_LIMIT_AUTH=30
RATE_LIMIT_API=120
